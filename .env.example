# Resend (https://resend.com) – Versand der Anmelde-Mails und der Login-Links für /intern
RESEND_API_KEY=
# Absender: muss zu einer in Resend verifizierten Domain gehören (ntgl.at).
# Bis die Domain verifiziert ist, funktioniert nur onboarding@resend.dev (nur an eigene Adresse).
MAIL_FROM="NTGL <anmeldung@ntgl.at>"
# Empfänger der Anmeldungen (Komma-getrennt); die erste Adresse ist auch Reply-To der Login-Mails
MAIL_TO=info.ntgl@proton.me

# Google Sheets – Anmeldungen zusätzlich in eine Tabelle schreiben (optional)
# Service-Account aus der Google Cloud Console; die Tabelle muss für diese E-Mail freigegeben sein.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private Key aus der JSON-Datei; Zeilenumbrüche als \n
GOOGLE_PRIVATE_KEY=
# ID der Tabelle (aus der URL), Blattname optional
SHEET_ID=
SHEET_TAB=Anmeldungen

# ---------- Mitgliederbereich /intern ----------
# Google Sheet „NTGL Verein Daten“ (für den Service-Account als Bearbeiter freigegeben)
INTERN_SHEET_ID=
# Zufälliger Schlüssel für Login-Links und Sitzungen, mind. 32 Zeichen
# (z. B. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
AUTH_SECRET=
# Startzugang mit vollen Rechten, solange der Vorstand im Sheet noch nicht eingetragen ist (Komma-getrennt)
INTERN_ADMIN_EMAILS=
# Vercel → Project → Settings → Git → Deploy Hooks (Branch main); „Veröffentlichen“ und der Cron rufen ihn auf
DEPLOY_HOOK_URL=
# Vercel schickt ihn beim Cron als „Authorization: Bearer …“ mit
CRON_SECRET=
# Nur lokal: 1 = Login-Link im Browser zeigen statt Mail zu senden (nur im Dev-Server wirksam)
INTERN_DEV_LINK=
