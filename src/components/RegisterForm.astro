---
interface Props {
  eventLabel: string;
  status: 'open' | 'closed' | 'soon';
}
const { eventLabel, status } = Astro.props;
---

<section id="anmeldung" class="border-t border-fog-800/60 bg-fog-haze">
  <div class="container-narrow py-14 sm:py-20">
    <div class="mx-auto max-w-xl">
      <h2 class="text-display text-5xl text-white sm:text-6xl">Anmeldung</h2>
      <p class="mt-3 text-fog-300">
        Private Veranstaltung: Ohne Anmeldung kein Einlass. Name und E-Mail reichen, wir melden uns nur wegen dieser Party.
      </p>

      {
        status === 'open' ? (
          <form
            id="register-form"
            method="post"
            action="/api/register"
            class="mt-8 space-y-5 rounded-2xl border border-fog-800/80 bg-ink-800/70 p-6 shadow-2xl shadow-black/40 sm:p-8"
            novalidate
          >
            <input type="hidden" name="event" value={eventLabel} />
            <input type="hidden" name="ts" value="" data-ts />
            <div class="hidden" aria-hidden="true">
              <label>
                Website
                <input type="text" name="website" tabindex="-1" autocomplete="off" />
              </label>
            </div>

            <div>
              <label for="name" class="mb-2 block text-sm font-medium text-fog-100">
                Name
              </label>
              <input
                id="name"
                name="name"
                type="text"
                required
                minlength="2"
                maxlength="80"
                autocomplete="name"
                placeholder="Vor- und Nachname"
                class="field"
              />
            </div>

            <div>
              <label for="email" class="mb-2 block text-sm font-medium text-fog-100">
                E-Mail
              </label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="du@example.at"
                class="field"
              />
            </div>

            <label class="flex items-start gap-3 text-sm text-fog-300">
              <input
                type="checkbox"
                name="consent"
                required
                class="mt-1 h-4 w-4 shrink-0 rounded border-fog-700 bg-ink accent-signal"
              />
              <span>
                Ich stimme zu, dass Name und E-Mail-Adresse zur Organisation dieser Veranstaltung verarbeitet werden, und
                habe die{' '}
                <a href="/datenschutz" class="text-white underline decoration-fog-700 underline-offset-4 hover:decoration-signal">
                  Datenschutzerklärung
                </a>{' '}
                gelesen. Mir ist bekannt, dass bei der Veranstaltung Fotos und Videos entstehen können.
              </span>
            </label>

            <label class="flex items-start gap-3 text-sm text-fog-300">
              <input
                type="checkbox"
                name="newsletter"
                class="mt-1 h-4 w-4 shrink-0 rounded border-fog-700 bg-ink accent-signal"
              />
              <span>Ich möchte per E-Mail über künftige NTGL-Partys informiert werden (jederzeit abbestellbar).</span>
            </label>

            <p id="register-message" class="hidden rounded-xl px-4 py-3 text-sm" role="status" aria-live="polite" />

            <button type="submit" class="btn-primary w-full" data-submit>
              Anmelden
            </button>
          </form>
        ) : (
          <div class="mt-8 rounded-2xl border border-dashed border-fog-700 p-8 text-center text-fog-300">
            {status === 'soon' ? 'Die Anmeldung öffnet bald.' : 'Die Anmeldung ist geschlossen.'}
          </div>
        )
      }
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#register-form');
  if (form) {
    const ts = form.querySelector<HTMLInputElement>('[data-ts]');
    if (ts) ts.value = String(Date.now());

    const button = form.querySelector<HTMLButtonElement>('[data-submit]');
    const message = document.querySelector<HTMLParagraphElement>('#register-message');

    const show = (text: string, ok: boolean) => {
      if (!message) return;
      message.textContent = text;
      message.className = `rounded-xl px-4 py-3 text-sm ${
        ok ? 'bg-fog-800/80 text-fog-100' : 'bg-signal/20 text-white'
      }`;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      if (button) {
        button.disabled = true;
        button.textContent = 'Wird gesendet …';
      }
      try {
        const payload = Object.fromEntries(new FormData(form).entries());
        const res = await fetch('/api/register', {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = (await res.json()) as { ok: boolean; error?: string };
        if (data.ok) {
          show('Danke, du bist angemeldet. Bis bald im GRNGR!', true);
          form.reset();
          if (ts) ts.value = String(Date.now());
        } else {
          show(data.error ?? 'Das hat nicht geklappt. Bitte noch einmal versuchen.', false);
        }
      } catch {
        show('Keine Verbindung. Bitte später noch einmal versuchen.', false);
      } finally {
        if (button) {
          button.disabled = false;
          button.textContent = 'Anmelden';
        }
      }
    });
  }
</script>
