---
import Intern from '../../../layouts/Intern.astro';
import Karte from '../../../components/intern/Karte.astro';
import Marke from '../../../components/intern/Marke.astro';
import { ladeLage } from '../../../lib/intern/daten';
import { datumLang, zeitstempel } from '../../../lib/intern/format';
import { darf } from '../../../lib/intern/rollen';
import { env } from '../../../lib/env';
import { freigabeBauen, freigabeLesen, medienUrl } from '../../../lib/website';

export const prerender = false;

const m = Astro.locals.mitglied!;
const lage = await ladeLage();
const entwurf = freigabeBauen(lage.t, `${m.name} <${m.email}>`);
const aktuell = freigabeLesen(lage.t.freigaben);
const versionen = [...lage.t.freigaben].sort((a, b) => String(b.zeit).localeCompare(String(a.zeit))).slice(0, 10);
const vergleich = (x: unknown) => JSON.stringify(x, (k, v) => (k === 'zeit' || k === 'wer' ? undefined : v));
const geaendert = !aktuell || vergleich(aktuell) !== vergleich(entwurf);
const journalSeit = aktuell
  ? lage.t.journal.filter((j) => String(j.zeit) > aktuell.zeit && ['veranstaltungen', 'lineup', 'galerie'].includes(String(j.tabelle)))
  : [];
const darfVeroeffentlichen = darf(m, 'website.veroeffentlichen');
const hook = Boolean(env('DEPLOY_HOOK_URL'));
const heute = new Date().toISOString().slice(0, 10);
const nurName = (wer: string) => wer.replace(/\s*<.*>$/, '');
const ANMELDUNG: Record<string, string> = { open: 'offen', soon: 'bald', closed: 'geschlossen' };
const kommende = entwurf.veranstaltungen.filter((v) => v.datum >= heute);
---

<Intern titel="Website" untertitel="Was der Mitgliederbereich auf ntgl.at steuert: Partys, Line-up, Hinweise, Flyer und Galerie. Online geht nur, was hier freigegeben wird.">
  <div class="grid gap-4 lg:grid-cols-3">
    <Karte titel="Status">
      {geaendert ? <Marke text="Änderungen warten" ton="warnung" /> : <Marke text="Website ist aktuell" ton="gut" />}
      <p class="mt-3 text-sm text-fog-300">
        {aktuell ? `Zuletzt veröffentlicht ${zeitstempel(aktuell.zeit)} von ${nurName(aktuell.wer)}.` : 'Noch nie veröffentlicht; die Website zeigt die Markdown-Dateien aus dem Repo.'}
      </p>
      {journalSeit.length > 0 && <p class="mt-2 text-xs text-fog">{journalSeit.length} Änderungen seit der letzten Freigabe.</p>}
    </Karte>
    <Karte titel="Veröffentlichen" class="lg:col-span-2">
      <p class="text-sm text-fog-300">
        Friert den Stand unten als neue Version ein und baut die Seite neu (etwa 1–2 Minuten). Täglich prüft ein Cron um 5 bzw. 6 Uhr, ob die Seite wegen eines
        Datumswechsels neu gebaut werden muss; Inhalte veröffentlicht er nie von selbst.
      </p>
      {
        darfVeroeffentlichen ? (
          <form method="post" action="/intern/api/veroeffentlichen" class="mt-4 flex flex-wrap items-center gap-3" onsubmit="return confirm('Diesen Stand jetzt auf ntgl.at veröffentlichen?')">
            <input type="hidden" name="_aktion" value="veroeffentlichen" />
            <button class="btn-primary" type="submit" disabled={!geaendert && Boolean(aktuell)}>
              {geaendert ? 'Jetzt veröffentlichen' : 'Nichts zu veröffentlichen'}
            </button>
            {!hook && <span class="text-xs text-fog">Ohne DEPLOY_HOOK_URL wird nur die Version gespeichert, der Build muss dann von Hand laufen.</span>}
          </form>
        ) : (
          <p class="mt-3 text-sm text-fog">Veröffentlichen dürfen Obmann/Obfrau und Schriftführer:in. Du kannst alles vorbereiten.</p>
        )
      }
    </Karte>
  </div>

  <h2 class="text-display mb-3 mt-8 text-3xl text-white">Vorschau des Entwurfs</h2>
  {
    kommende.length === 0 ? (
      <p class="rounded-2xl border border-dashed border-fog-700 p-6 text-sm text-fog-300">
        Keine kommende Party mit „Auf Website: ja“. Die Website zeigt dann weiter die Markdown-Dateien. <a href="/intern/verwaltung/planung" class="underline">Zur Planung</a>
      </p>
    ) : (
      <div class="grid gap-4 lg:grid-cols-2">
        {kommende.map((v) => (
          <article class="rounded-2xl border border-fog-800/80 bg-ink-800/60 p-5">
            <div class="flex gap-4">
              {v.flyer ? (
                <img src={`/intern/api/bild/${v.flyer}`} alt="Flyer" class="h-28 w-28 shrink-0 rounded-xl object-cover ring-1 ring-fog-700" />
              ) : (
                <div class="flex h-28 w-28 shrink-0 items-center justify-center rounded-xl border border-dashed border-fog-700 text-xs text-fog">kein Flyer</div>
              )}
              <div class="min-w-0">
                <p class="text-xs uppercase tracking-widest text-fog">{v.datumFix ? datumLang(v.datum) : 'Datum folgt'}</p>
                <h3 class="text-display text-3xl text-white">{v.titel}</h3>
                {v.untertitel && <p class="text-fog-300">{v.untertitel}</p>}
                <p class="mt-1 text-sm text-fog-300">
                  {v.einlass ?? '22:00'}–{v.ende ?? '06:00'} · {v.location ?? 'GRNGR'} · {v.preistext ?? 'Preistext aus der Datei'}
                </p>
                <p class="mt-1 text-xs text-fog">Anmeldung: {v.anmeldung ? ANMELDUNG[v.anmeldung] : 'wie in der Datei'}</p>
              </div>
            </div>
            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              <div>
                <p class="mb-1 text-xs uppercase tracking-widest text-fog">Line-up</p>
                {v.lineup.length ? (
                  <ul class="space-y-1 text-sm">
                    {v.lineup.map((a) => (
                      <li class="text-fog-100">
                        <span class="font-mono text-xs text-fog">{a.time ?? ''}</span> {a.artist}
                        {a.genre && <span class="text-fog"> · {a.genre}</span>}
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="text-sm text-fog-300">Line-up aus der Datei bzw. „Line-up folgt“</p>
                )}
              </div>
              <div>
                <p class="mb-1 text-xs uppercase tracking-widest text-fog">Hinweise</p>
                {v.hinweise?.length ? (
                  <ul class="list-disc space-y-1 pl-4 text-sm text-fog-100">
                    {v.hinweise.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                ) : (
                  <p class="text-sm text-fog-300">aus der Datei</p>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    )
  }

  {
    entwurf.bilder.length > 0 && (
      <>
        <h3 class="mb-3 mt-6 text-sm font-medium uppercase tracking-widest text-fog">Galerie auf der Website ({entwurf.bilder.length})</h3>
        <ul class="grid grid-cols-4 gap-2 sm:grid-cols-6 lg:grid-cols-8">
          {entwurf.bilder.map((b) => (
            <li>
              <img src={`/intern/api/bild/${b.id}`} alt={b.titel ?? ''} class="aspect-square w-full rounded-lg object-cover" loading="lazy" />
            </li>
          ))}
        </ul>
      </>
    )
  }

  <h2 class="text-display mb-3 mt-10 text-3xl text-white">Versionen</h2>
  {
    versionen.length === 0 ? (
      <p class="text-sm text-fog-300">Noch keine Freigabe.</p>
    ) : (
      <div class="overflow-x-auto rounded-2xl border border-fog-800/80 bg-ink-800/50">
        <table class="w-full min-w-[36rem] text-left text-sm">
          <thead class="border-b border-fog-800 text-xs uppercase tracking-wider text-fog">
            <tr>
              <th class="px-4 py-3 font-medium">Zeit</th>
              <th class="px-4 py-3 font-medium">Wer</th>
              <th class="px-4 py-3 font-medium">Inhalt</th>
              <th class="px-4 py-3" />
            </tr>
          </thead>
          <tbody class="divide-y divide-fog-800/70">
            {versionen.map((z, i) => (
              <tr>
                <td class="px-4 py-2 text-white">{zeitstempel(String(z.zeit))}</td>
                <td class="px-4 py-2">{nurName(String(z.wer))}</td>
                <td class="px-4 py-2 text-fog-300">{String(z.zusammenfassung)}</td>
                <td class="px-4 py-2 text-right">
                  {i === 0 ? (
                    <Marke text="aktuell" ton="gut" />
                  ) : (
                    darfVeroeffentlichen && (
                      <form method="post" action="/intern/api/veroeffentlichen" onsubmit="return confirm('Diese ältere Version wieder veröffentlichen?')">
                        <input type="hidden" name="_aktion" value="wiederherstellen" />
                        <input type="hidden" name="_id" value={z.id} />
                        <button class="text-xs text-fog underline decoration-fog-700 underline-offset-4 hover:text-white" type="submit">
                          wiederherstellen
                        </button>
                      </form>
                    )
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
  <p class="mt-4 text-xs text-fog">Öffentliche Bild-Adresse eines Flyers: {entwurf.veranstaltungen[0]?.flyer ? `ntgl.at${medienUrl(entwurf.veranstaltungen[0].flyer)}` : '–'}</p>
</Intern>
